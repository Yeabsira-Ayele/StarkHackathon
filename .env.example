# Copy to .env and fill in. Never commit .env.

# ---- Server
PORT=5000
NODE_ENV=development
# Comma-free origin, or * for local development
CORS_ORIGIN=*

# ---- Database
MONGO_URI=mongodb://127.0.0.1:27017/lewegene

# ---- Person 1 auth stub (TEMP until Person 1's middleware is merged)
# HS256 secret used by src/middlewares/_stubAuth.js
JWT_SECRET=change-me-to-a-long-random-text-at-least-32-characters

# ---- Person 3 payments
# mock | links.et     mock simulates checkout with no real money
PAYMENT_PROVIDER=mock
# Where the donor's browser returns after checkout
PAYMENT_RETURN_URL=http://localhost:5173/donations/return
# Where links.et (or the mock) posts payment events
PAYMENT_CALLBACK_URL=http://localhost:5000/api/payments/webhook

# links.et — leave blank while PAYMENT_PROVIDER=mock.
# The adapter fails closed until TODO(links.et) paths are filled from their docs.
LINKS_ET_API_KEY=
LINKS_ET_BASE_URL=
LINKS_ET_WEBHOOK_SECRET=

# Skip the initialize/verify rate limit during local testing. Person 4 owns the global limiter.
DISABLE_RATE_LIMIT=true
