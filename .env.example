# MongoDB connection string
MONGO_URI=

# HTTP port the server listens on
PORT=

# Runtime environment (e.g. development, production)
NODE_ENV=

# Shared secret sent as the x-admin-key header for admin routes
ADMIN_KEY=

# API key for links.et receipt verification
LINKS_ET_API_KEY=

# Optional. Defaults to https://links.et
LINKS_ET_URL=

# Comma-separated allowed receiver names
EXPECTED_RECEIVER_NAME=

# Set to 1 when behind a reverse proxy
TRUST_PROXY=

# true only for local testing
DISABLE_RATE_LIMIT=
