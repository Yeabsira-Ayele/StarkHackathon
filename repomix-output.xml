          <div class="nums"><span id="dRaised"></span><span id="dGoal"></span></div>
          <div id="deleteMsg" class="msg" hidden></div>

          <h3>Donate with a payment receipt</h3>
          <p class="muted">Pay first by telebirr, CBE, Zemen, Bank of Abyssinia or Awash to the account set in <code>EXPECTED_RECEIVER_NAME</code>, then paste the receipt link. The amount is read from the receipt.</p>
          <form id="donateForm">
