          <label>Category
            <select id="filterCategory">
              <option value="">all</option>
              <option>medical</option><option>education</option><option>emergency</option>
              <option>business</option><option>other</option>
            </select>
          </label>
        </div>
        <ul id="campaigns" class="list"></ul>
      </section>
    </div>

    <!-- Right column: selected campaign + log -->
    <div class="col">
      <section class="panel">
