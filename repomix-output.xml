            <label>Image URL <input name="imageUrl" type="url" placeholder="optional"></label>
          </div>
          <button class="primary" type="submit">Create campaign</button>
          <div id="createMsg" class="msg" hidden></div>
        </form>
      </details>

      <section class="panel">
        <h2>Campaigns <span id="total" class="muted"></span></h2>
        <div class="filters">
