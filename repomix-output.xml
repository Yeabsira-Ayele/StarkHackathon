        <input id="serverUrl" type="url" value="http://localhost:5000" spellcheck="false">
      </label>
      <button id="check" type="button">Check connection</button>
    </div>
    <span id="status" class="pill" role="status">Not checked</span>
  </header>

  <div class="grid">

    <!-- Left column: campaigns -->
    <div class="col">
      <details class="panel form" open>
        <summary>Create a campaign</summary>
        <form id="createForm">
          <label>Title <input name="title" required maxlength="120"></label>
          <label>Story <textarea name="story" required></textarea></label>
          <div class="row">
            <label>Goal amount (ETB) <input name="goalAmount" type="number" min="1" step="any" required></label>
            <label>Category
              <select name="category">
                <option value="other">other</option>
