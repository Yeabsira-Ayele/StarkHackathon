<script>
"use strict";

const $ = (sel) => document.querySelector(sel);
const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const money = (n) => Number(n || 0).toLocaleString(undefined, { maximumFractionDigits: 2 }) + " ETB";

const store = {
  get(k) { try { return localStorage.getItem(k); } catch { return null; } },
  set(k, v) { try { localStorage.setItem(k, v); } catch { /* storage unavailable */ } },
};

let serverUrl = store.get("serverUrl") || "http://localhost:5000";
let selectedId = null;
$("#serverUrl").value = serverUrl;

// ---------------------------------------------------------------- API

// The receipt link is like a credential, so the log only shows its host.
function redact(body) {
  if (!body || !body.receiptUrl) return body;
  let host = "…";
  try { host = new URL(body.receiptUrl).hostname; } catch { /* keep placeholder */ }
  return { ...body, receiptUrl: host + "/(hidden)" };
}

function setStatus(up) {
  const el = $("#status");
  el.className = "pill " + (up ? "up" : "down");
  el.textContent = up ? "Server reachable" : "Cannot reach server";
}

async function api(method, path, body, opts = {}) {
  const shownPath = (opts.root ? "" : "/api") + path;
  const url = serverUrl.replace(/\/+$/, "") + shownPath;
  const started = performance.now();
  let status = 0, data = null, networkError = null;

  try {
    const res = await fetch(url, {
      method,
      headers: body ? { "Content-Type": "application/json" } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
    status = res.status;
    try { data = await res.json(); } catch { data = null; }
    setStatus(true);
  } catch (err) {
    networkError = err.message;
    setStatus(false);
  }

  addLog({ method, path: shownPath, status, data, networkError, body: redact(body), ms: Math.round(performance.now() - started) });
  return { status, data, networkError };
}

function addLog(e) {
  const log = $("#log");
  log.querySelectorAll("details").forEach((d) => { d.open = false; });

  const tone = e.networkError || e.status >= 500 ? "bad" : e.status >= 400 ? "warn" : "ok";
  const shown = e.networkError
    ? { error: e.networkError, hint: "Is the server running? Is the Server URL correct?" }
    : e.data;
  const sent = e.body ? "// request body\n" + JSON.stringify(e.body, null, 2) + "\n\n// response\n" : "";

  const li = document.createElement("li");
  li.innerHTML =
    `<details open><summary><span class="st ${tone}">${e.status || "ERR"}</span>` +
    `<code class="path">${esc(e.method)} ${esc(e.path)}</code><span class="ms">${e.ms} ms</span></summary>` +
    `<pre>${esc(sent + JSON.stringify(shown, null, 2))}</pre></details>`;
  log.prepend(li);
  while (log.children.length > 15) log.lastChild.remove();
}

function showMsg(el, kind, text) {
  el.hidden = false;
  el.className = "msg " + kind;
  el.textContent = text;
}

// ---------------------------------------------------------- connection

async function checkConnection() {
  await api("GET", "/", null, { root: true });
}

$("#check").addEventListener("click", checkConnection);
$("#serverUrl").addEventListener("change", (e) => {
  serverUrl = e.target.value.trim() || "http://localhost:5000";
  store.set("serverUrl", serverUrl);
  checkConnection().then(loadCampaigns);
});

// ----------------------------------------------------------- campaigns

function barHtml(c) {
  const pct = Math.min(Number(c.progress ?? 0), 100);
  return `<div class="bar"><i style="width:${pct}%"></i></div>` +
         `<div class="nums"><span>${money(c.raisedAmount)} raised</span><span>${pct}% of ${money(c.goalAmount)}</span></div>`;
}

async function loadCampaigns() {
  const params = new URLSearchParams({ limit: "20" });
  const category = $("#filterCategory").value;
  const search = $("#search").value.trim();
  if (category) params.set("category", category);
  if (search) params.set("search", search);

  const { status, data } = await api("GET", "/campaigns?" + params);
  const list = $("#campaigns");

  if (status !== 200) {
    list.innerHTML = `<li class="muted">Could not load campaigns. See the log below.</li>`;
    $("#total").textContent = "";
    return;
  }

  $("#total").textContent = `(${data.pagination.total})`;
  if (data.campaigns.length === 0) {
    list.innerHTML = `<li class="muted">No campaigns yet. Create one above.</li>`;
    return;
  }

  list.innerHTML = data.campaigns.map((c) =>
    `<li><button type="button" class="item" data-id="${esc(c._id)}" aria-current="${c._id === selectedId}">` +
    `<span class="top"><span>${esc(c.title)}</span><span class="cat">${esc(c.category)}</span></span>` +
    barHtml(c) + `</button></li>`
  ).join("");
}

$("#campaigns").addEventListener("click", (e) => {
  const btn = e.target.closest("button[data-id]");
  if (btn) selectCampaign(btn.dataset.id);
});

let searchTimer;
$("#search").addEventListener("input", () => { clearTimeout(searchTimer); searchTimer = setTimeout(loadCampaigns, 300); });
$("#filterCategory").addEventListener("change", loadCampaigns);

$("#createForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.target;
  const msg = $("#createMsg");
  const f = Object.fromEntries(new FormData(form));
  const payload = {
    title: f.title, story: f.story, goalAmount: Number(f.goalAmount), category: f.category,
    creatorName: f.creatorName || undefined, imageUrl: f.imageUrl || undefined,
  };

  const { status, data, networkError } = await api("POST", "/campaigns", payload);
  if (status === 201) {
    showMsg(msg, "ok", "Campaign created.");
    form.reset();
    await loadCampaigns();
    selectCampaign(data._id);
  } else {
    showMsg(msg, "err", networkError ? "Cannot reach the server." : (data?.message || "Something went wrong."));
  }
});

// ------------------------------------------------------ campaign detail

async function selectCampaign(id) {
  selectedId = id;
  $("#donateMsg").hidden = true;
  $("#deleteMsg").hidden = true;

  const [c, d] = await Promise.all([
    api("GET", `/campaigns/${id}`),
    api("GET", `/donations/${id}?limit=20`),
  ]);
  if (c.status !== 200) { showMsg($("#deleteMsg"), "err", c.data?.message || "Could not load campaign."); return; }

  const camp = c.data;
  $("#empty").hidden = true;
  $("#detail").hidden = false;
  $("#dTitle").textContent = camp.title;
  $("#dMeta").textContent = `${camp.category} · by ${camp.creatorName} · created ${new Date(camp.createdAt).toLocaleDateString()}`;
  $("#dStory").textContent = camp.story;
  $("#dBar").style.width = Math.min(camp.progress, 100) + "%";
  $("#dRaised").textContent = money(camp.raisedAmount) + " raised";
  $("#dGoal").textContent = `${camp.progress}% of ${money(camp.goalAmount)}`;

  renderDonations(d.status === 200 ? d.data : null);

  document.querySelectorAll("#campaigns .item").forEach((b) => b.setAttribute("aria-current", String(b.dataset.id === id)));
}

function renderDonations(payload) {
  const box = $("#donations");
  if (!payload) { box.innerHTML = `<p class="muted">Could not load donations.</p>`; $("#dCount").textContent = ""; return; }

  $("#dCount").textContent = `(${payload.pagination.total})`;
  if (payload.donations.length === 0) {
    box.innerHTML = `<p class="muted">No verified donations yet.</p>`;
    return;
  }
  box.innerHTML = payload.donations.map((x) =>
    `<div class="donation"><div class="who"><span>${esc(x.donorName)}</span><span>${money(x.amount)}</span></div>` +
    `<div class="muted">${esc(x.provider || "")} · ${new Date(x.createdAt).toLocaleString()}</div>` +
    (x.message ? `<div>${esc(x.message)}</div>` : "") + `</div>`
  ).join("");
}

$("#donateForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.target;
  const btn = $("#donateBtn");
  const msg = $("#donateMsg");
  const f = Object.fromEntries(new FormData(form));

  btn.disabled = true;
  const label = btn.textContent;
  btn.textContent = "Verifying receipt…"; // the bank lookup can take a while
  msg.hidden = true;

  const { status, data, networkError } = await api("POST", `/donations/${selectedId}`, {
    receiptUrl: f.receiptUrl.trim(),
    donorName: f.donorName || undefined,
    message: f.message || undefined,
  });

  btn.disabled = false;
  btn.textContent = label;

  if (status === 201) {
    showMsg(msg, "ok", `Verified: ${money(data.donation.amount)} via ${data.donation.provider}. Thank you!`);
    form.reset();
    await Promise.all([selectCampaign(selectedId), loadCampaigns()]);
  } else if (networkError) {
    showMsg(msg, "err", "Cannot reach the server.");
  } else {
    showMsg(msg, "err", `${data?.message || "Something went wrong."}${data?.code ? ` (${data.code})` : ""}`);
  }
});

$("#deleteBtn").addEventListener("click", async () => {
  if (!confirm("Delete this campaign?")) return;
  const { status, data } = await api("DELETE", `/campaigns/${selectedId}`);
  if (status === 200) {
    selectedId = null;
    $("#detail").hidden = true;
    $("#empty").hidden = false;
    loadCampaigns();
  } else {
    showMsg($("#deleteMsg"), "err", data?.message || "Could not delete.");
  }
});

// -------------------------------------------------------------- start
checkConnection().then(loadCampaigns);
</script>
</body>
</html>
